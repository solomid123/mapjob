# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & Secrets
.env
.env.*
*.env
google_service_account.json
credentials.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# Browser profiles: these hold live signed-in sessions and auth cookies.
# Committing one hands over the account it is signed into.
.chrome_profile/
.chrome_profile_test/
agent_profile/

# Cookie jars and saved sessions
saved_cookies.json
cookies_vault.json
services/automation/saved_cookies.json
services/automation/cookies_vault.json
services/automation/cookies_vault.prev.json
services/automation/cloud_account.json

# Candidate documents (PII)
*_CV.pdf
Badreddine_Barki_CV.pdf

# Debug artefacts from agent runs: screenshots and captured page HTML
*.png
*.jpg
*.jpeg
/*.html
scratch/

# ...but the app's own wallpapers are source assets, not artefacts. Without
# this the build has no background on any machine but the one it was added on.
!public/wallpaper-*.jpg

# Same mistake, worse consequence: /*.html was meant to catch captured pages
# dumped at the repo root by agent runs, and it also caught index.html -- the
# Vite entry point, which has therefore never been tracked. A fresh clone
# cannot build. Un-ignore it by name and leave the artefact rule alone.
!/index.html
.claude/
nul

# The agent's own memory: which portals it has registered on, and what every
# run came to. Both are personal and neither is source.
services/automation/portal_accounts.json
services/automation/applications.jsonl

# The outreach ledger: real companies and real contact people, i.e. personal
# data. It is per-machine state, not source.
services/automation/outreach.db
services/automation/outreach.db-wal
services/automation/outreach.db-shm
services/automation/verify_cache.db
services/automation/verify_cache.db-wal
services/automation/verify_cache.db-shm

# Generated applications: a cover letter naming a real company, and the pack
# with the CV merged after it. Personal data twice over -- the candidate's and
# the employer's contact's -- and regenerated from the ledger on demand.
services/automation/dossiers/

# The cloud engine remembers its uploaded CV id here. Account-scoped, not code.
services/automation/browser_use_cache.json

# The profile page writes here: home address, phone, employment history.
services/automation/profile.json

# Tailored CVs and letters: a home address and an employment history per job.
services/automation/documents/

# Connected mailboxes: one refresh token per account. A key to somebody's mail.
services/automation/mailboxes.json
services/automation/mailboxes.part
