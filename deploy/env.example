# Every environment variable the backend reads, with no values in it.
#
# This is a checklist for a new machine, not a config file: copy it to .env at
# the repository root and fill in what you actually use. Most lines are
# optional and the app says so at runtime rather than refusing to start -- the
# apply engine reports which keys are missing instead of failing on import.
#
# Nothing here should ever be committed with a value after the '='.

# --- the model behind everything -----------------------------------------
# Fuelix speaks the OpenAI protocol; one key covers the writer, the planner,
# the page agent and the live interview helper.
FUELIX_API_KEY=
FUELIX_BASE_URL=
FUELIX_WRITER=
FUELIX_PLANNER=
FUELIX_BRAIN=
FUELIX_PAGE_AGENT=
FUELIX_LIVE=
FUELIX_WRITER_FALLBACK=
FUELIX_PLANNER_FALLBACK=
FUELIX_BRAIN_FALLBACK=
FUELIX_LIVE_FALLBACK=

# --- the rented browser ---------------------------------------------------
# A key pasted into Profile -> Applying outranks this one, and is where a
# replacement belongs when an account runs out of credit.
BROWSER_USE_API_KEY=
BROWSER_USE_PROFILE_ID=
BROWSER_USE_API_BASE=
BROWSER_USE_MODEL=
BROWSER_USE_PROXY_COUNTRY=
BROWSER_USE_WORKSPACE_ID=
BROWSER_USE_AUTO_SEED=      # 0 stops the cookie seeding of a fresh profile
BROWSER_USE_SEED_GOOGLE=    # left unset on purpose: Google is held back

# --- sending mail ---------------------------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=         # an app password, never the account password
GMAIL_USER=
OUTREACH_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gmail over OAuth, per user ------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Supabase -------------------------------------------------------------
# The service-role key is server-side only and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# --- finding and checking people -----------------------------------------
PARALLEL_API_KEY=
PARALLEL_PROCESSOR=
PARALLEL_CONTACT_PROCESSOR=
PARALLEL_PEOPLE_PROCESSOR=
PARALLEL_TIMEOUT=
MYEMAILVERIFIER_API_KEY=

# --- the interview helper -------------------------------------------------
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
AZURE_KIMI_KEY=
AZURE_KIMI_ENDPOINT=
AZURE_KIMI_DEPLOYMENT=

# --- portal sign-ins the local engine uses -------------------------------
# The agent is never allowed to type any of these into accounts.google.com.
PORTAL_EMAIL=
PORTAL_PASSWORD_PRIMARY=
PORTAL_PASSWORD_SECONDARY=
PORTAL_SIGNUP_PASSWORD=
GOOGLE_LOGIN_EMAIL=
GOOGLE_LOGIN_PASSWORD=
CANDIDATE_ACCOUNT_PASSWORD=
CANDIDATE_FALLBACK_PASSWORD=
MAPJOB_PASSWORD=            # the lock on the profile page; default 1234

# --- where things are kept -----------------------------------------------
# Unset means "next to the module", which is right on a desk. In the
# container entrypoint.sh symlinks those names out to /data, so these stay
# empty there too unless you want them somewhere else.
CANDIDATE_PROFILE_STORE=
CANDIDATE_PROFILE_STORE_DIR=
CANDIDATE_CV_EN=
CV_MASTER_DIR=
DOCUMENT_LIBRARY_DIR=
TAILORED_DOCUMENTS_DIR=
MAILBOX_STORE=
DECKBLATT_FONT_DIR=
CHROME_PATH=                # the local engine only; the container has none

# --- read by the SPA at build time, not by the server --------------------
# These are baked into the JavaScript and are public by definition. Put them
# in the Pages project's environment variables, not here.
VITE_API_BASE_URL=          # https://api.example.com -- required when deployed
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=
VITE_ADZUNA_APP_ID=
VITE_ADZUNA_APP_KEY=
MAPBOX_TOKEN=

