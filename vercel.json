{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://mapjob-backend.onrender.com/api/:match*"
    },
    {
      "source": "/cv.pdf",
      "destination": "https://mapjob-backend.onrender.com/cv.pdf"
    },
    {
      "source": "/Badreddine_Barki_CV.pdf",
      "destination": "https://mapjob-backend.onrender.com/Badreddine_Barki_CV.pdf"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
